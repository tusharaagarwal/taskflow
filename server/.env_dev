POSTGRES_HOST=database_host
POSTGRES_PORT=database_port
POSTGRES_DB=database_name
POSTGRES_USER=database_user
POSTGRES_PASSWORD=database_password

# Application Configuration
SECRET_KEY=secret_key
DEBUG=debug
ENVIRONMENT=environment

# JWT Configuration
JWT_ALGORITHM=jwt_algorithm
ACCESS_TOKEN_EXPIRE_MINUTES=expire_minutes


# for agent
API_BASE_URL=http://127.0.0.1:8003/v1

# Anthropic / Claude Configuration
USE_ANTHROPIC=true
ANTHROPIC_API_KEY=yourkey
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Azure OpenAI Configuration (fallback)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# AZURE_OPENAI_API_VERSION=2023-05-15

USE_MOCK_MODE=false

# AWS Messaging Configuration
AWS_REGION=aws_region
AWS_ACCESS_KEY_ID=aws_access_key_id
AWS_SECRET_ACCESS_KEY=aws_secret_access_key
AWS_SESSION_TOKEN=aws_session_token
MESSAGING_ENABLED=messaging_enabled
ASSEMBLER_TASK_QUEUE_NAME=assembler_task_queue_name
ASSEMBLER_TASK_TOPIC_NAME=assembler_task_topic_name
ASSEMBLER_MESSAGE_GROUP_ID=assembler_message_group_id
ASSEMBLER_COMPLETION_QUEUE_NAME=assembler_completion_queue_name
ASSEMBLER_TASK_QUEUE_URL=assembler_task_queue_url
ASSEMBLER_COMPLETION_QUEUE_URL=assembler_completion_queue_url
CONSUMER_NOTIFICATION_TOPIC_NAME=consumer_notification_topic_name
CONSUMER_NOTIFICATION_QUEUE_NAME=consumer_notification_queue_name
CONSUMER_NOTIFICATION_QUEUE_URL=consumer_notification_queue_url
CONSUMER_NOTIFICATION_MESSAGE_GROUP_ID=consumer_notification_message_group_id
SQS_MAX_MESSAGES=sqs_max_messages
SQS_WAIT_TIME_SECONDS=sqs_wait_time_seconds
SQS_VISIBILITY_TIMEOUT=sqs_visibility_timeout
SQS_POLL_INTERVAL=sqs_poll_interval
SQS_AUTO_DELETE_MESSAGES=sqs_auto_delete_messages
SNS_DEFAULT_MESSAGE_GROUP_ID=sns_default_message_group_id
ORCHESTRATOR_API_BASE_URL=orchestrator_api_base_url